# Server listens on your local network; configure the edge with this host's address.
SERVER_BIND_ADDRESS=0.0.0.0
SERVER_PORT=4399
# Defaults reproduce the complete realtime deployment. Install its edge AEC reader first.
OH2P_REALTIME=1
OH2P_AEC_READY=1
OH2P_CANCEL_READY=1
OH2P_QUIET_CONNECT=1
# Account/device identity and pairing code belong only in ignored data/config.py.
